# URL publique (origine autorisée, liens des e-mails, WebAuthn)
APP_URL=https://pointeuse.boi.lu
# WEBAUTHN_RP_ID=pointeuse.boi.lu      # par défaut : le domaine de APP_URL

PORT=3000
DATABASE_PATH=./data/pointeuse.db
# Derrière un reverse proxy (Caddy/Nginx) : true (défaut en production)
# TRUST_PROXY=true

# E-mails (mot de passe oublié). Sans SMTP, les e-mails sont affichés dans la console.
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.lu:465
# MAIL_FROM="Pointeuse <no-reply@boi.lu>"

# Notifications push (rappels). Générer avec : npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@boi.lu
