{
  "name": "pointeuse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pointeuse — web app de pointage personnelle (pointeuse.boi.lu)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n worker,web -c blue,magenta \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:worker": "wrangler dev --port 8787",
    "dev:web": "vite",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply pointeuse --remote",
    "db:migrate:local": "wrangler d1 migrations apply pointeuse --local",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.12",
    "luxon": "^3.7.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  }
}
